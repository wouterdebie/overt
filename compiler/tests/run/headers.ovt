// Declarations imported from C headers: zlib's and sqlite's.

extern "z" header "zlib.h"

extern "sqlite3" header "sqlite3.h" {
  blocking fn sqlite3_exec(db: *sqlite3, sql: *u8, callback: *u8, arg: *u8, errmsg: **u8) -> ffi.int
}

fn crc(text: str) -> ffi.ulong ! io {
  let data = text.bytes()
  return unsafe { crc32(0, ffi.data(data), ffi.uint(data.len())) }
}

fn main() ! io, fail {
  print(crc("hello, world"))
  print(Z_OK)
  print(Z_BEST_COMPRESSION)
  var db: *sqlite3 = ffi.null()
  print(unsafe { sqlite3_open(":memory:".c_str(), inout db) } == SQLITE_OK)
  var err: *u8 = ffi.null()
  let rc = unsafe { sqlite3_exec(db, "create table t (x int)".c_str(), ffi.null(), ffi.null(), inout err) }
  print(rc == SQLITE_OK)
  print(SQLITE_ROW)
  print(SQLITE_IOERR_READ)
  print(unsafe { sqlite3_close(db) } == SQLITE_OK)
}
