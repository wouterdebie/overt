// Bit operations on sized integers, their assignment forms, and a constant
// table that is changed in a copy.
const TABLE: [u32] = [1, 0xffffffff, 0x80000000]

fn main() ! io {
  let x: u32 = 0x0f0f0f0f
  print((!x).hex())
  print((x << 4).hex())
  print((x >> 4).hex())
  print((x +% 0xf1f1f1f1).hex())
  print((x & 0xff) | 0x100)
  let y: u8 = 0x3c
  print((!y).hex())
  print((y ^ 0xff).hex())
  var t = TABLE
  t[0] = 7
  print(t)
  print(TABLE)
  print(255.hex())
  var h: [u32] = [1, 2]
  h[0] +%= 0xffffffff
  h[1] ^= 3
  h[1] <<= 4
  var z: u32 = 5
  z |= 8
  z &= 12
  z >>= 1
  z -%= 7
  z *%= 3
  print("${h} ${z}")
  // A literal argument needn't be named, even next to one of the same type.
  print(rotr(1, 1))
}

fn rotr(x: u32, n: u32) -> u32 {
  return (x >> n) | (x << (32 - n))
}
