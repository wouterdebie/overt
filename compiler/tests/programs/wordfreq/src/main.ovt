// A reference wordfreq, used to test the compiler (tasks/01-wordfreq is written by fresh agents).
fn count_words(text: str) -> Map[str, int] {
  var counts: Map[str, int] = {}
  var start = -1
  for i in 0..text.len() {
    if text[i].is_alpha() {
      if start < 0 {
        start = i
      }
    } else if start >= 0 {
      let w = text[start..i].to_lower()
      counts[w] = (counts.get(w) else 0) + 1
      start = -1
    }
  }
  if start >= 0 {
    let w = text[start..].to_lower()
    counts[w] = (counts.get(w) else 0) + 1
  }
  return counts
}

fn main() ! io, fail {
  let args = os.args()
  if args.len() != 2 {
    fail(.Invalid, "usage: wordfreq <file> <n>")
  }
  let n = int.parse(args[1]) else fail(.Invalid, "n must be a non-negative integer, got \"${args[1]}\"")
  if n < 0 {
    fail(.Invalid, "n must be a non-negative integer, got ${n}")
  }
  let bytes = fs.read_bytes(args[0])?
  let text = str.from_bytes(bytes) else fail(.Invalid, "${args[0]} isn't UTF-8 text")
  var pairs = count_words(text).pairs()
  pairs.sort_by(|p| (-p.1, p.0))
  for i, p in pairs {
    if i >= n {
      break
    }
    print("${p.1} ${p.0}")
  }
}
