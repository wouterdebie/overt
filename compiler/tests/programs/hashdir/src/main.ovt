// hashdir <dir>: the SHA-256 of every file under a directory, like
// `shasum -a 256`, hashed in parallel.

fn main() ! io, fail {
  let args = os.args()
  if args.len() != 1 {
    fail(.Invalid, "usage: hashdir <dir>")
  }
  let dir = args[0]
  let prefix = if dir.ends_with("/") { dir } else { dir + "/" }
  let files = fs.walk(dir)?.filter(|e| e.kind == .File)
  let hashes = task.map(files, |e| sha256(fs.read_bytes(prefix + e.path)?))?
  for i, e in files {
    print("${hashes[i]}  ${prefix}${e.path}")
  }
}

const K: [u32] = [
  0x428a2f98,
  0x71374491,
  0xb5c0fbcf,
  0xe9b5dba5,
  0x3956c25b,
  0x59f111f1,
  0x923f82a4,
  0xab1c5ed5,
  0xd807aa98,
  0x12835b01,
  0x243185be,
  0x550c7dc3,
  0x72be5d74,
  0x80deb1fe,
  0x9bdc06a7,
  0xc19bf174,
  0xe49b69c1,
  0xefbe4786,
  0x0fc19dc6,
  0x240ca1cc,
  0x2de92c6f,
  0x4a7484aa,
  0x5cb0a9dc,
  0x76f988da,
  0x983e5152,
  0xa831c66d,
  0xb00327c8,
  0xbf597fc7,
  0xc6e00bf3,
  0xd5a79147,
  0x06ca6351,
  0x14292967,
  0x27b70a85,
  0x2e1b2138,
  0x4d2c6dfc,
  0x53380d13,
  0x650a7354,
  0x766a0abb,
  0x81c2c92e,
  0x92722c85,
  0xa2bfe8a1,
  0xa81a664b,
  0xc24b8b70,
  0xc76c51a3,
  0xd192e819,
  0xd6990624,
  0xf40e3585,
  0x106aa070,
  0x19a4c116,
  0x1e376c08,
  0x2748774c,
  0x34b0bcb5,
  0x391c0cb3,
  0x4ed8aa4a,
  0x5b9cca4f,
  0x682e6ff3,
  0x748f82ee,
  0x78a5636f,
  0x84c87814,
  0x8cc70208,
  0x90befffa,
  0xa4506ceb,
  0xbef9a3f7,
  0xc67178f2,
]

fn rotr(x: u32, n: u32) -> u32 {
  return (x >> n) | (x << (32 - n))
}

// The SHA-256 digest of `data`, as 64 hex digits.
fn sha256(data: [u8]) -> str
  ex sha256("abc".bytes()) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
  ex sha256([]) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
{
  var h: [u32] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  var msg = data
  msg.push(0x80)
  while msg.len() % 64 != 56 {
    msg.push(0)
  }
  let bits = u64(data.len()) * 8
  for i in 0..8 {
    msg.push(u8((bits >> u64(56 - 8 * i)) & 0xff))
  }
  var w: [u32] = [0].repeat(64)
  var start = 0
  while start < msg.len() {
    for t in 0..16 {
      let j = start + 4 * t
      w[t] = (u32(msg[j]) << 24) | (u32(msg[j + 1]) << 16) | (u32(msg[j + 2]) << 8) | u32(msg[j + 3])
    }
    for t in 16..64 {
      let s0 = rotr(w[t - 15], n: 7) ^ rotr(w[t - 15], n: 18) ^ (w[t - 15] >> 3)
      let s1 = rotr(w[t - 2], n: 17) ^ rotr(w[t - 2], n: 19) ^ (w[t - 2] >> 10)
      w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
      let s1 = rotr(e, n: 6) ^ rotr(e, n: 11) ^ rotr(e, n: 25)
      let ch = (e & f) ^ (!e & g)
      let t1 = hh +% s1 +% ch +% K[t] +% w[t]
      let s0 = rotr(a, n: 2) ^ rotr(a, n: 13) ^ rotr(a, n: 22)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = s0 +% maj
      hh = g
      g = f
      f = e
      e = d +% t1
      d = c
      c = b
      b = a
      a = t1 +% t2
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
    start += 64
  }
  var out = ""
  for x in h {
    out += x.hex()
  }
  return out
}
